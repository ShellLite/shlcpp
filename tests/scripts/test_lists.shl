to binary_search_rec(arr, target, low, high)
    if low > high
        give -1
    mid = int((low + high) / 2)
    val = arr[mid]
    if val == target
        give mid
    elif val < target
        give binary_search_rec(arr, target, mid + 1, high)
    else
        give binary_search_rec(arr, target, low, mid - 1)

to binary_search(arr, target)
    give binary_search_rec(arr, target, 0, arr.len() - 1)

to test_list_indexing_and_slicing
    nums = [10, 20, 30, 40, 50]
    assert(nums[0] == 10, "nums[0] failed")
    assert(nums[4] == 50, "nums[4] failed")
    assert(nums[-1] == 50, "nums[-1] failed")
    assert(nums[-2] == 40, "nums[-2] failed")

    nums[2] = 99
    assert(nums[2] == 99, "nums[2] mutation failed")

    sub = nums[1:4]
    assert(sub.len() == 3, "sub slice length failed")
    assert(sub[0] == 20, "sub[0] failed")
    assert(sub[1] == 99, "sub[1] failed")
    assert(sub[2] == 40, "sub[2] failed")

    rev = nums[::-1]
    assert(rev.len() == 5, "rev length failed")
    assert(rev[0] == 50, "rev[0] failed")
    assert(rev[4] == 10, "rev[4] failed")

    stride = nums[::2]
    assert(stride.len() == 3, "stride length failed")
    assert(stride[0] == 10, "stride[0] failed")
    assert(stride[1] == 99, "stride[1] failed")
    assert(stride[2] == 50, "stride[2] failed")

to test_list_methods_and_ops
    my_list = [1, 2]
    my_list.append(3)
    my_list.append(4)
    assert(my_list.len() == 4, "append len failed")

    popped_last = my_list.pop()
    assert(popped_last == 4, "pop last failed")
    assert(my_list.len() == 3, "len after pop last failed")

    popped_idx = my_list.pop(1)
    assert(popped_idx == 2, "pop index 1 failed")
    assert(my_list.len() == 2, "len after pop idx failed")
    assert(my_list[0] == 1, "my_list[0] failed")
    assert(my_list[1] == 3, "my_list[1] failed")

    combined = my_list + [100, 200]
    assert(combined.len() == 4, "list concatenation len failed")
    assert(combined[2] == 100, "combined[2] failed")
    assert(combined[3] == 200, "combined[3] failed")

    combined.clear()
    assert(combined.len() == 0, "clear failed")

to test_list_comprehensions
    base = [1, 2, 3, 4]
    squared = [x * x for x in base]
    assert(squared.len() == 4, "comprehension len failed")
    assert(squared[0] == 1, "squared 0 failed")
    assert(squared[1] == 4, "squared 1 failed")
    assert(squared[2] == 9, "squared 2 failed")
    assert(squared[3] == 16, "squared 3 failed")

to test_binary_search_algorithm
    sorted_data = [2, 5, 8, 12, 16, 23, 38, 56, 72, 91]
    assert(binary_search(sorted_data, 23) == 5, "binary_search 23 failed")
    assert(binary_search(sorted_data, 2) == 0, "binary_search 2 failed")
    assert(binary_search(sorted_data, 91) == 9, "binary_search 91 failed")
    assert(binary_search(sorted_data, 100) == -1, "binary_search missing failed")

test_list_indexing_and_slicing()
test_list_methods_and_ops()
test_list_comprehensions()
test_binary_search_algorithm()
say "Lists tests passed"
